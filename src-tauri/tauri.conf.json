{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PC Dashboard",
  "version": "1.0.0",
  "identifier": "com.h3nrx.control",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "PC Dashboard",
        "width": 1180,
        "height": 760,
        "resizable": false,
        "maximizable": false,
        "center": true,
        "decorations": false,
        "transparent": true,
        "shadow": true,
        "visible": false,
        "windowEffects": { "effects": ["acrylic"] }
      }
    ],
    "security": { "csp": null, "assetProtocol": { "enable": true, "scope": [] } }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.ico", "icons/icon.png"]
  }
}
